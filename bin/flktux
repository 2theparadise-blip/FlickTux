#!/usr/bin/env bash
# ==============================================================================
# FlickTux (flktux) Unified CLI & Atomic Toggle Launcher
# ==============================================================================
set -euo pipefail

REAL_SOURCE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${REAL_SOURCE}")" && pwd)"
PKG_ROOT="$(dirname "${SCRIPT_DIR}")"
[ ! -d "${PKG_ROOT}/flktux" ] && PKG_ROOT="/opt/flicktux"

RUST_BIN="${SCRIPT_DIR}/flktux-rs"
PID_FILE="${HOME}/.config/flktux/flktux.pid"

CMD="${1:-toggle}"

if [ "${CMD}" = "toggle" ] || [ "${CMD}" = "-t" ] || [ "${CMD}" = "--toggle" ]; then
    # Check if UI or Rust core is already running (do NOT match launcher itself)
    UI_PIDS=$(pgrep -f "flktux\.ui|flktux-rs" 2>/dev/null || true)
    if [ -n "${UI_PIDS}" ]; then
        pkill -f "flktux\.ui" 2>/dev/null || true
        pkill -f "flktux-rs" 2>/dev/null || true
        rm -f "${PID_FILE}" 2>/dev/null || true
        exit 0
    fi

    # Launch UI
    if [ -x "${RUST_BIN}" ] && file "${RUST_BIN}" 2>/dev/null | grep -q "ELF"; then
        exec "${RUST_BIN}" ui
    else
        exec python3 -c "import sys; sys.path.insert(0, '${PKG_ROOT}'); from flktux.ui import main; main()"
    fi
else
    # Pass all other subcommands (emit, dry, presets, devices, run, web, --help) directly to Rust core
    if [ -x "${RUST_BIN}" ] && file "${RUST_BIN}" 2>/dev/null | grep -q "ELF"; then
        exec "${RUST_BIN}" "$@"
    else
        exec python3 "${SCRIPT_DIR}/flktux.py" "$@"
    fi
fi
