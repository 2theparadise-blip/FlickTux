#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
flktux: FlickTux CLI & Toggle Executable
Command name: flktux
"""

import sys
import os
import subprocess

# Ensure package directory is in sys.path
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PKG_ROOT = os.path.dirname(SCRIPT_DIR)
if PKG_ROOT not in sys.path:
    sys.path.insert(0, PKG_ROOT)


def is_running():
    try:
        out = subprocess.check_output(["pgrep", "-f", "flktux.*ui.py"], text=True)
        pids = [int(p) for p in out.strip().split() if int(p) != os.getpid()]
        return pids
    except Exception:
        return []


def toggle():
    pids = is_running()
    if pids:
        for pid in pids:
            try:
                os.kill(pid, 15)  # SIGTERM
            except Exception:
                pass
        sys.exit(0)
    else:
        from flktux.ui import main
        main()


def main_cli():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd in ("--toggle", "-t", "toggle"):
        toggle()
    elif cmd in ("--settings", "-s", "settings", "config"):
        from flktux.settings_gui import main as settings_main
        settings_main()
    elif cmd in ("--help", "-h"):
        print("Usage: flktux [COMMAND]")
        print("")
        print("Commands:")
        print("  (no args)   Start FlickTux floating keyboard")
        print("  toggle, -t  Toggle show/hide FlickTux")
        print("  settings,-s Open Wacom & FlickTux sensitivity settings")
        print("  help, -h    Show this help message")
    else:
        toggle()


if __name__ == '__main__':
    main_cli()
